diff --git a/packages/app/src/pages/layout/desktop-deep-links.tsx b/packages/app/src/pages/layout/desktop-deep-links.tsx
new file mode 100644
index 0000000000..333df2f9d3
--- /dev/null
+++ b/packages/app/src/pages/layout/desktop-deep-links.tsx
@@ -0,0 +1,104 @@
+import { createEffect, onCleanup, onMount } from "solid-js"
+import { createStore } from "solid-js/store"
+import { useNavigate } from "@solidjs/router"
+import { base64Encode } from "@opencode-ai/core/util/encode"
+import { retry } from "@opencode-ai/core/util/retry"
+import { useLayout } from "@/context/layout"
+import { usePlatform } from "@/context/platform"
+import { useServer } from "@/context/server"
+import { useServerSDK } from "@/context/server-sdk"
+import { useServerSync } from "@/context/server-sync"
+import { setSessionHandoff } from "@/pages/session/handoff"
+import { SessionRouteKey, SessionStateKey } from "@/utils/server-scope"
+import { listAllSessions } from "@/utils/session"
+import { sessionHref } from "@/utils/session-route"
+import { listenForDeepLinks, parseDeepLink, parseNewSessionDeepLink } from "./deep-links"
+import { latestRootSession } from "./helpers"
+
+export function DesktopDeepLinks() {
+  const platform = usePlatform()
+  const server = useServer()
+  const serverSDK = useServerSDK()
+  const serverSync = useServerSync()
+  const layout = useLayout()
+  const navigate = useNavigate()
+  const serverKey = server.key
+  const scope = server.scope()
+  const [state, setState] = createStore({ urls: [] as string[], current: undefined as string | undefined })
+  const meta = { disposed: false, cleanup: () => {} }
+
+  onMount(() => {
+    if (platform.platform !== "desktop") return
+    meta.cleanup = listenForDeepLinks(window, (urls) => setState("urls", (current) => [...current, ...urls]))
+  })
+
+  onCleanup(() => {
+    meta.disposed = true
+    meta.cleanup()
+    const pending = [...(state.current ? [state.current] : []), ...state.urls]
+    if (pending.length === 0) return
+    window.__OPENCODE__ ??= {}
+    window.__OPENCODE__.deepLinks = [...pending, ...(window.__OPENCODE__.deepLinks ?? [])]
+  })
+
+  createEffect(() => {
+    if (!serverSync().ready || state.current || state.urls.length === 0) return
+    const url = state.urls[0]
+    setState({ urls: state.urls.slice(1), current: url })
+    void handle(url).finally(() => {
+      if (!meta.disposed) setState("current", undefined)
+    })
+  })
+
+  async function handle(url: string) {
+    const directory = parseDeepLink(url)
+    if (directory) {
+      await openProject(directory)
+      return
+    }
+
+    const link = parseNewSessionDeepLink(url)
+    if (!link || meta.disposed) return
+    layout.projects.open(link.directory)
+    layout.home.setSelection({ server: serverKey, directory: link.directory })
+    const slug = base64Encode(link.directory)
+    if (link.prompt) {
+      setSessionHandoff(SessionStateKey.from(scope, SessionRouteKey.fromLegacy(slug)), {
+        prompt: link.prompt,
+      })
+    }
+    navigate(link.prompt ? `/${slug}/session?prompt=${encodeURIComponent(link.prompt)}` : `/${slug}/session`)
+  }
+
+  async function openProject(directory: string) {
+    const project = await retry(() => serverSDK().api.project.current({ location: { directory } })).catch(
+      () => undefined,
+    )
+    const root = project?.directory ?? directory
+    const workspaces = project
+      ? await retry(() => serverSDK().api.project.directories({ projectID: project.id, location: { directory: root } }))
+          .then((items) => items.map((item) => item.directory))
+          .catch(() => [])
+      : []
+    const directories = [root, ...workspaces.filter((item) => item !== root)]
+    const latest = latestRootSession(
+      await Promise.all(
+        directories.map(async (item) => ({
+          path: { directory: item },
+          session: await retry(() =>
+            listAllSessions(serverSDK().api.session, { directory: item, parentID: null, order: "desc" }),
+          ).catch(() => []),
+        })),
+      ),
+      Date.now(),
+    )
+
+    if (meta.disposed) return
+    layout.projects.open(root)
+    server.projects.touch(root)
+    layout.home.setSelection({ server: serverKey, directory: root })
+    navigate(latest ? sessionHref(serverKey, latest.id) : `/${base64Encode(root)}/session`)
+  }
+
+  return null
+}
diff --git a/packages/desktop/src/main/deep-link.ts b/packages/desktop/src/main/deep-link.ts
new file mode 100644
index 0000000000..359189b98b
--- /dev/null
+++ b/packages/desktop/src/main/deep-link.ts
@@ -0,0 +1,30 @@
+export function parseDeepLinkWindow(input: string) {
+  if (!input.startsWith("opencode://")) return "current"
+
+  try {
+    const url = new URL(input)
+    if (url.hostname !== "open-project") return "current"
+    return url.searchParams.get("window") === "new" ? "new" : "current"
+  } catch {
+    return "current"
+  }
+}
+
+export function partitionDeepLinks(urls: string[]) {
+  return urls.reduce(
+    (result, url) => {
+      if (parseDeepLinkWindow(url) === "new") {
+        result.newWindows.push([url])
+        return result
+      }
+
+      result.current.push(url)
+      return result
+    },
+    { current: [] as string[], newWindows: [] as string[][] },
+  )
+}
+
+export function extractDeepLinks(argv: string[]) {
+  return argv.filter((arg) => arg.startsWith("opencode://"))
+}
diff --git a/packages/desktop/src/main/deep-link.test.ts b/packages/desktop/src/main/deep-link.test.ts
new file mode 100644
index 0000000000..ef3cc33236
--- /dev/null
+++ b/packages/desktop/src/main/deep-link.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, test } from "bun:test"
+import { extractDeepLinks, parseDeepLinkWindow, partitionDeepLinks } from "./deep-link"
+
+describe("desktop deep links", () => {
+  test("routes open-project window=new to a new window", () => {
+    expect(parseDeepLinkWindow("opencode://open-project?directory=/tmp/demo&window=new")).toBe("new")
+  })
+
+  test("keeps other deep links on the current window", () => {
+    expect(parseDeepLinkWindow("opencode://open-project?directory=/tmp/demo")).toBe("current")
+    expect(parseDeepLinkWindow("opencode://new-session?directory=/tmp/demo&window=new")).toBe("current")
+    expect(parseDeepLinkWindow("https://example.com")).toBe("current")
+  })
+
+  test("partitions deep links by target window", () => {
+    expect(
+      partitionDeepLinks([
+        "opencode://open-project?directory=/a",
+        "opencode://open-project?directory=/b&window=new",
+        "opencode://new-session?directory=/c",
+      ]),
+    ).toEqual({
+      current: ["opencode://open-project?directory=/a", "opencode://new-session?directory=/c"],
+      newWindows: [["opencode://open-project?directory=/b&window=new"]],
+    })
+  })
+
+  test("extracts an encoded Windows project deep link from launch arguments", () => {
+    const url = "opencode://open-project?directory=C%3A%5CUsers%5CNorman%5C.dotfiles"
+    expect(extractDeepLinks(["electron.exe", "C:\\app\\index.js", url])).toEqual([url])
+  })
+})
